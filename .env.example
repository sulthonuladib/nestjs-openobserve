# ---------------------------------------------------------------------------
# nestjs-openobserve — environment
#
# Only OBSERVE_DATABASE_URL is required. Everything else has a usable default.
# ---------------------------------------------------------------------------

# Postgres. Any 13+ server; the image ships none of its own.
OBSERVE_DATABASE_URL=postgres://observe:observe@localhost:5433/observe

# The test suite truncates every table. It reads this variable only, and refuses
# a database whose name does not end in `_test`.
# OBSERVE_TEST_DATABASE_URL=postgres://observe:observe@localhost:5433/observe_test
OBSERVE_DATABASE_POOL=20

# One port serves ingest, the query API and the dashboard.
OBSERVE_PORT=4320
OBSERVE_HOST=0.0.0.0

# The origin operators and agents see. Used for invite links, the device-code
# verification URL and webhooks. Set it to the real hostname in production.
OBSERVE_PUBLIC_URL=http://localhost:4320

# Apply migrations at boot. Set to 0 when a release job runs them instead.
OBSERVE_RUN_MIGRATIONS=1

# Accept batches that carry no x-api-key / x-api-secret. The SDK sends none when
# unconfigured, which is how a local collector is meant to work. Turn it off once
# every application has a key and the port is reachable from the internet.
OBSERVE_ALLOW_ANONYMOUS_INGEST=1

# Trust X-Forwarded-For (only behind a proxy you control).
OBSERVE_TRUST_PROXY=0

OBSERVE_LOG_LEVEL=info
