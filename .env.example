# ---------------------------------------------------------------------------
# NestJS Observe (self-hosted) — environment
#
# Only OBSERVE_DATABASE_URL is required. Everything else has a usable default.
# ---------------------------------------------------------------------------

# Postgres. Any 13+ server; the image ships none of its own.
OBSERVE_DATABASE_URL=postgres://observe:observe@localhost:5433/observe
OBSERVE_DATABASE_POOL=20

# Listeners. Ingest is internet-facing; the dashboard usually is not.
OBSERVE_HOST=0.0.0.0
OBSERVE_INGEST_PORT=4319
OBSERVE_API_PORT=4320
# 1 = serve ingest and dashboard on OBSERVE_API_PORT only (one reverse proxy).
OBSERVE_SINGLE_PORT=0

# Apply migrations at boot. Set to 0 when a release job runs them instead.
OBSERVE_RUN_MIGRATIONS=1

# Accept batches that carry no x-api-key / x-api-secret.
# The SDK's "collector of your own" path relies on this being on for local
# development. Turn it off when the ingest port is reachable from the internet.
OBSERVE_ALLOW_ANONYMOUS_INGEST=1

# The origin operators see: used for the /dashboard/link device-code page.
OBSERVE_PUBLIC_URL=http://localhost:4320

OBSERVE_LOG_LEVEL=info
