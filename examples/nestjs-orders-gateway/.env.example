# The collector, which also serves the dashboard.
OBSERVE_ENDPOINT=http://localhost:4320
PORT=3200

# Shown as the application in the dashboard. It is derived the way the setup
# wizard derives one from the package name's last segment, so `orders-gateway`
# for `@examples/orders-gateway`. The SDK has no default: it has to be passed.
OBSERVE_SERVICE_ID=orders-gateway
SERVICE_VERSION=1.0.0

# From `npx @nestjs/observe link` against the collector, or Settings → API keys.
# OBSERVE_APP_KEY=
# OBSERVE_APP_SECRET=

# The service this gateway calls. `nestjs-orders-api` listens here.
ORDERS_API=http://localhost:3100
