# The collector, which also serves the dashboard.
OBSERVE_ENDPOINT=http://localhost:4320

# The TCP port this microservice listens on.
PORT=3301

# Shown as the application in the dashboard. Derived the way the setup wizard
# derives one from the package name's last segment.
OBSERVE_SERVICE_ID=pricing-service
SERVICE_VERSION=1.0.0

# From `npx @nestjs/observe link` against the collector, or Settings → API keys.
# OBSERVE_APP_KEY=
# OBSERVE_APP_SECRET=
