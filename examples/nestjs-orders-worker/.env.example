# The collector, which also serves the dashboard.
OBSERVE_ENDPOINT=http://localhost:4320

# Shown as the application in the dashboard. The API uses orders-api.
OBSERVE_SERVICE_ID=orders-worker
SERVICE_VERSION=1.0.0

# From `npx @nestjs/observe link` against the collector, or Settings → API keys.
# OBSERVE_APP_KEY=
# OBSERVE_APP_SECRET=

# docker-compose.yml in ../ starts both on these ports.
DATABASE_URL=postgres://orders:orders@localhost:5434/orders
REDIS_HOST=127.0.0.1
REDIS_PORT=6380
