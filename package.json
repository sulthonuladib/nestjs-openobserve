{
  "name": "nestjs-openobserve",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "bun --hot src/server/index.ts",
    "build": "bun run compile",
    "compile": "bun build --compile --target bun --outfile dist/nestjs-openobserve src/server/index.ts",
    "start": "bun src/server/index.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "bun test test",
    "test:conformance": "bun test test/conformance",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun scripts/migrate.ts",
    "admin": "bun src/server/index.ts admin",
    "db:reset": "bash scripts/reset-db.sh"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.4.2",
    "@elysiajs/cron": "^1.4.2",
    "@elysiajs/eden": "^1.4.9",
    "@elysiajs/openapi": "^1.4.16",
    "@elysiajs/static": "^1.4.10",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/material": "^9.5.0",
    "@nivo/bar": "^0.99.0",
    "@nivo/core": "^0.99.0",
    "@nivo/line": "^0.99.0",
    "@phosphor-icons/react": "^2.1.10",
    "@sinclair/typebox": "^0.34.52",
    "@tanstack/react-query": "^5.104.5",
    "@tanstack/react-router": "^1.170.46",
    "drizzle-orm": "^0.45.4",
    "drizzle-typebox": "^0.3.3",
    "elysia": "^1.4.30",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "tailwindcss": "^4.3.3",
    "uplot": "^1.6.32"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "bun-plugin-tailwind": "^0.1.2",
    "drizzle-kit": "^0.31.11",
    "typescript": "^7"
  }
}
