{
  "compilerOptions": {
    // Environment setup & latest features
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "target": "ESNext",
    "module": "Preserve",
    "moduleDetection": "force",
    // One app, one package: the browser bundle (`public/`) and the collector
    // (`src/server`) are typechecked by this single config, so Bun's Fullstack
    // Dev Server needs no second TS project and no workspace exports map.
    "jsx": "react-jsx",
    "allowJs": true,
    "types": ["bun"],

    // Bundler mode
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,

    // Best practices
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,

    // Some stricter flags (disabled by default)
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noPropertyAccessFromIndexSignature": false
  },
  // `repos/` is a vendored git subtree: read-only reference material for agents
  // and humans, never compiled, never type-checked, never bundled.
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "public/**/*.ts",
    "public/**/*.tsx",
    "test/**/*.ts",
    "scripts/**/*.ts",
    "drizzle.config.ts"
  ],
  "exclude": ["node_modules", "dist", "repos", "**/drizzle/**"]
}
